{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Augur",
  "version": "0.2.0",
  "identifier": "com.neostryder.augur",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @augur/ui dev",
    "beforeBuildCommand": "pnpm --filter @augur/ui build"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Augur",
        "width": 400,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "neostryder",
    "copyright": "Copyright (c) 2026 neostryder. MIT License.",
    "category": "Utility",
    "shortDescription": "AI plan usage and credit balances in your tray",
    "longDescription": "Augur shows how much of your AI plans and credits you have used, for Claude, ChatGPT and Codex, Grok, MiniMax, OpenRouter, fal and Jev, and warns before a limit runs out.",
    "homepage": "https://github.com/neostryder/augur",
    "license": "MIT",
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxOTkwMjIwNjcwMDFGMDYKUldRR0h3Qm5JQUtaWWRzY0p2Mkp2aXlQaFU1eEtWa2Zadk1RUWlRZG9KbVZHRS96anBHMnhMR1cK",
      "endpoints": [
        "https://github.com/neostryder/augur/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
